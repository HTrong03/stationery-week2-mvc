<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StationeryWeek2.Mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StationeryWeek2.Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">

                <a class="navbar-brand"
                asp-controller="Home"
                asp-action="Index">
                    Stationery MVC
                </a>

                <ul class="navbar-nav ms-4 gap-3">

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active-nav" : "")"
                        asp-area=""
                        asp-controller="Home"
                        asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stationeries" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active-nav" : "")"
                        asp-area=""
                        asp-controller="Stationeries"
                        asp-action="Index">
                            Products
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stationeries" && ViewContext.RouteData.Values["Action"]?.ToString() == "Stats" ? "active-nav" : "")"
                        asp-area=""
                        asp-controller="Stationeries"
                        asp-action="Stats">
                            Stats
                        </a>
                    </li>

                </ul>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="background-color: rgb(233, 231, 231);">
        <div class="container">
            &copy; 2026 - StationeryWeek2.Mvc - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
