@model List<StationeryWeek2.Mvc.ViewModels.StationeryListItemViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Product Catalog</h2>
        <p class="text-muted">
            Đây là trang danh sách sản phẩm của cửa hàng.
        </p>
    </div>

    <a asp-controller="Stationeries"
       asp-action="Stats"
       class="btn btn-primary" style="background-color: rgb(65, 129, 220); transition:0.3s;" onmouseover="this.style.transform='scale(1.01)'; this.style.backgroundColor='rgb(57, 66, 219)'"
   onmouseout="this.style.transform='scale(1)'; this.style.backgroundColor='rgb(65, 129, 220)';">>
        📊 Xem thống kê tồn kho
    </a>
</div>

<div class="alert alert-info d-flex align-items-center mb-3" style="width: 30%; background-color: rgb(231, 247, 255)">
    <strong>ℹ️ Tổng số sản phẩm: @Model.Count</strong>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Loại</th>
            <th>Thương hiệu</th>
            <th>Giá bán</th>
            <th>Số lượng</th>
            <th>Giá trị tồn kho</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Code</td>
            <td>@item.Name</td>
            <td>@item.Category</td>
            <td>@item.Brand</td>
            <td>@item.PriceText</td>
            <td>@item.Quantity</td>
            <td>@item.InventoryValueText</td>

            <td>
                <span class="@item.StockStatusClass">
                    @item.StockStatus
                </span>
            </td>

            <td>
                <a class="btn btn-sm btn-dark"
                   href="/Stationeries/Detail/@item.Id">
                    Xem
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>